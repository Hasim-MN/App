# MediaFlow Downloader Environment Variables

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Allowed Frontend Origins (comma-separated or wildcard for dev)
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "*"]

# Resource Limits
MAX_FILE_SIZE_BYTES=2147483648  # 2 GB
MAX_CONCURRENT_JOBS=10
JOB_TIMEOUT_SECONDS=600         # 10 minutes
JOB_RETENTION_SECONDS=1800      # 30 minutes before deletion of temp files
CLEANUP_INTERVAL_SECONDS=300    # 5 minutes

# Frontend API URL (for Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: Cloud Deployment (Render/VPS) YouTube Anti-Bot Bypass
# Paste Netscape cookie file content or base64 string
# YOUTUBE_COOKIES=
# Optional: Proxy (if using residential proxy on cloud hosts)
# HTTP_PROXY=
